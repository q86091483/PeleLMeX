#----------------------DOMAIN DEFINITION------------------------
geometry.is_periodic = 0 0 0                         # For each dir, 0: non-perio, 1: periodic
geometry.coord_sys   = 0                              # 0 => cart, 1 => RZ
geometry.prob_lo     = -0.6 -0.6 0.0                   # x_lo y_lo (z_lo)
geometry.prob_hi     = 0.6 0.6 1.5             # x_hi y_hi (z_hi)

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# Interior, Inflow, Outflow, Symmetry,
# SlipWallAdiab, NoSlipWallAdiab, SlipWallIsotherm, NoSlipWallIsotherm
peleLM.lo_bc = Outflow Outflow Inflow
peleLM.hi_bc = Outflow Outflow Outflow


#-------------------------AMR CONTROL----------------------------
#amr.n_cell          = 96 96 144        # Level 0 number of cells in each direction   
amr.n_cell          = 288 288 360       # Level 0 number of cells in each direction   
#amr.n_cell          = 144 144 180       # Level 0 number of cells in each direction   



amr.v               = 3                # AMR verbose
amr.max_level       = 1                # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 2         # refinement ratio
amr.regrid_int      = 2                # how often to regrid
amr.n_error_buf     = 4 2 2 2 2         # number of buffer cells in error est
amr.grid_eff        = 0.7              # what constitutes an efficient grid
amr.blocking_factor = 8 # 8               # block factor in grid generation (min box size)
#amr.blocking_factor = 4 # 8               # block factor in grid generation (min box size)


amr.max_grid_size   = 32             # max box size
#amr.max_grid_size   = 16             # max box size



#--------------------------- Problem -------------------------------
prob.D_fu = 0.15    # Radius of the fuel pipe

prob.V_fu = 0.5  # Speed of the fuel in inflow
prob.V_ox = 0.0 # Speed of the oxidizer in inflow
#prob.V_init = 0.3
prob.V_init = 0.5
#prob.V_init = 0.3



prob.T_fu = 300   # Temperature of the fuel
prob.T_ox = 300   # Temperature of the oxidizer
prob.ml_thickness = 0.015

prob.P_mean = 101325 # Ambient pressure in the chamber

prob.dilution = 1.0 # Proportion of h2 in the fuel mix. h2 is diluted in N2

pmf.datafile = "h2_burning_pmf.dat"
#pmf.datafile = "h2_incomplete_combustion_pmf.dat"


#-------------------------PeleLM CONTROL----------------------------
peleLM.gravity = 0.0 0.0 -9.81
peleLM.gradP0 = 0.0 0.0 -11.54637 # rho is 1.177 at 1atm and 300 K
peleLM.divu_dt_rhoMin = 0.01



peleLM.v = 3
peleLM.incompressible = 0
peleLM.rho = 1.17
peleLM.mu = 0.0
peleLM.use_wbar = 1
peleLM.sdc_iterMax = 2
peleLM.floor_species = 1
peleLM.num_init_iter = 3
peleLM.advection_scheme = "Godunov_PLM"
peleLM.do_temporals = 1 # use to calculate the integrals
peleLM.do_mass_balance = 1
#peleLM.deltaT_verbose = 1
peleLM.deltaT_iterMax = 15
peleLM.deltaT_crashIfFailing=0
#peleLM.unity_Le = 1

#amr.initDataPlt = plt_restart_with_flamelet
#amr.restart = chk84000
#amr.restart = chk86800 # chk72200
amr.check_int = 1
amr.plot_int = 1
amr.max_step = 1
amr.dt_shrink = 0.1
#amr.stop_time = 0.001
amr.init_dt = 0.000001
amr.cfl = 0.05 # from 0.5, error when 0.8
amr.derive_plot_vars = avg_pressure mag_vort mass_fractions mixture_fraction

#peleLM.chem_integrator = "ReactorNull"
peleLM.chem_integrator = "ReactorCvode"
peleLM.use_typ_vals_chem = 1          # Use species/temp typical values in CVODE
ode.rtol = 1.0e-6                     # Relative tolerance of the chemical solve
ode.atol = 1.0e-5                     # Absolute tolerance factor applied on typical values
cvode.solve_type = magma_direct # CVODE Linear solve type (for Newton direction) 
cvode.max_order  = 4                  # CVODE max BDF order. 


#---------------------- Derived CONTROLS -------------------------
peleLM.mixtureFraction.format = Cantera
peleLM.mixtureFraction.type   = mass
peleLM.mixtureFraction.oxidTank = O2:0.233 N2:0.767
peleLM.mixtureFraction.fuelTank = H2:1.0



#--------------------REFINEMENT CONTROL------------------------
amr.refinement_indicators = magVort yH
amr.magVort.max_level = 0
amr.magVort.value_greater = 200
amr.magVort.field_name = mag_vort

amr.yH.max_level     = 0
amr.yH.value_greater = 4.0e-5
amr.yH.field_name    = Y(H)




#------------------MLMG issue--------------------------------------
nodal_proj.verbose = 1
mac_proj.verbose = 1

nodal_proj.rtol = 5e-10
mac_proj.rtol = 5e-10
diffusion.rtol = 5e-10

#-----------------CVODE issue--------------------
ode.clean_init_massfrac = 1


# ================ gpu control=========
amrex.the_arena_is_managed=0
amrex.abort_on_out_of_gpu_memory = 1
amrex.signal_handling=0
amr.loadbalance_with_workestimates = 1




